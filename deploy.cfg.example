[sei]
# Caminhos locais do ambiente SEI em desenvolvimento

# Diretório de módulos SEI
modulos_dir = /var/www/html/sei/web/modulos

# Caminho completo do ConfiguracaoSEI.php
configuracao_sei = /var/www/html/sei/config/ConfiguracaoSEI.php

# Binário do PHP
php_bin = /usr/bin/php

# Onde guardar backups locais
backup_dir = /var/backups/sei-modulos

# Deploy automático após geração? (true/false)
auto_deploy = true

# Abrir log detalhado do resultado
verbose = true
