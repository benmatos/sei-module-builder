<?php /* View: dashboard — {{ d.nome }} */ ?>
<div class="infraAreaDados">
<h2 style="margin-bottom:16px">Dashboard — {{ d.nome }}</h2>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
  .dash-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:12px; margin-bottom:20px }
  .dash-card { background:#fff; border:1px solid #ddd; border-radius:6px; padding:16px; text-align:center }
  .dash-card .valor { font-size:2rem; font-weight:bold; color:#1a3a6b }
  .dash-card .label { font-size:.8rem; color:#666; margin-top:4px }
  .dash-charts { display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:16px }
  .dash-chart  { background:#fff; border:1px solid #ddd; border-radius:6px; padding:16px }
  .dash-chart h4 { margin:0 0 12px; font-size:.9rem; color:#333 }
</style>

<!-- Cards de totais -->
<div class="dash-grid">
  {% for tabela in d.tabelas %}
  <div class="dash-card">
    <div class="valor"><?php echo number_format($arrStats['total_{{ tabela.nome }}'] ?? 0); ?></div>
    <div class="label">{{ tabela.nome | pascalcase }}</div>
  </div>
  {% endfor %}
</div>

<!-- Gráficos de distribuição -->
<div class="dash-charts">
  {% for tabela in d.tabelas %}
  {% for col in tabela.colunas %}
  {% if col.tipo == 'char(1)' and not col.chave_primaria %}
  <div class="dash-chart">
    <h4>{{ tabela.nome | pascalcase }} — por {{ col.nome | pascalcase }}</h4>
    <canvas id="chart_{{ tabela.nome }}_{{ col.nome }}" height="220"></canvas>
    <script>
    (function(){
      var d = <?php echo json_encode($arrStats['dist_{{ tabela.nome }}_{{ col.nome }}'] ?? []); ?>;
      new Chart(document.getElementById('chart_{{ tabela.nome }}_{{ col.nome }}'), {
        type: 'doughnut',
        data: {
          labels:   d.map(function(r){ return r['Str{{ col.nome | pascalcase }}'] || '—'; }),
          datasets: [{
            data: d.map(function(r){ return parseInt(r.Total||0); }),
            backgroundColor: ['#1a3a6b','#2e7d32','#e6a817','#c62828','#37474f','#6a1b9a']
          }]
        },
        options: { plugins: { legend: { position: 'bottom' } }, cutout: '60%' }
      });
    })();
    </script>
  </div>
  {% endif %}
  {% endfor %}
  {% endfor %}
</div>

<div style="margin-top:16px">
  <a href="?acao=listar" class="infraButton">← Voltar</a>
</div>
</div>
