<?php
// {{ d.nome }} — Integração
// Gerado por SEI Module Builder v{{ d.versao }}

class {{ ns }}Integracao extends SeiIntegracao {

    public function getNome() { return '{{ d.nome }}'; }
    public function getDescricao() { return '{{ d.descricao }}'; }
    public function getVersao() { return '{{ d.versao }}'; }
    public function getInstituicao() { return '{{ d.autor }}'; }
    public function getVersaoSEIRequerida() { return '{{ d.sei_versao_min }}'; }

    public function inicializar($strVersaoSEI) {
        $strDir = dirname(__FILE__);
        infraAdicionarPath($strDir);
        infraAdicionarPath($strDir . '/rn');
        infraAdicionarPath($strDir . '/dto');
        infraAdicionarPath($strDir . '/bd');
        infraAdicionarPath($strDir . '/int');
    }


    public function getMenus() {
        $arrMenus = array();
        {% for menu in d.menus %}
        $arrMenus[] = array(
            'titulo'            => '{{ menu.titulo }}',
            'link'              => '{{ menu.link }}',
            'icone'             => '{{ menu.icone }}',
            'perfil_requerido'  => '{{ menu.perfil_requerido }}',
        );
        {% endfor %}
        return $arrMenus;
    }

    public function getRecursos() {
        return array(
            {% for recurso in d.recursos %}
            array('nome' => '{{ recurso.nome }}', 'descricao' => '{{ recurso.descricao }}'),
            {% endfor %}
        );
    }
    public function adicionarElementoMenu() {
        $strMenu = '';
        {% if "dashboard" in d.extras %}
        if (SessaoSEI::getInstance()->verificarPermissao('md_dashboard_visualizar')) {
            $strLink = SessaoSEI::getInstance()->assinarLink('controlador.php?acao=md_dashboard_visualizar');
            $strMenu .= '<li><a href="' . $strLink . '" class="infraMenuFilho"><div class="infraItemMenu"><div class="infraRotuloMenu">Dashboard</div></div></a></li>';
        }
        {% endif %}
        return $strMenu != '' ? $strMenu : null;
    }

    public function processarControlador($strAcao) {
        if (!$strAcao) return false;
        
        {% for t in d.tabelas %}
        if ($strAcao == '{{ t.nome }}_listar' || $strAcao == '{{ t.nome }}_cadastrar') {
            require_once dirname(__FILE__) . '/' . $strAcao . '.php';
            return true;
        }
        {% endfor %}

        switch ($strAcao) {
            {% if "dashboard" in d.extras %}
            case 'md_dashboard_visualizar':
                require_once dirname(__FILE__) . '/extras/{{ d.slug }}_dashboard.php';
                return true;
            {% endif %}
        }
        return false;
    }
}
