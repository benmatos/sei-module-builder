<?php
// Script de atualização SEI — {{ d.nome }}
// Gerado por SEI Module Builder

require_once dirname(dirname(dirname(dirname(__FILE__)))) . "/SEI.php";

try {
    $objInfraBanco = BancoSEI::getInstance();
    $objInfraBanco->abrirConexao();

    {% for tabela in d.tabelas %}
    // Tabela: {{ tabela.nome }}
    $bolExiste = false;
    try {
        $objInfraBanco->consultarSql("select 1 from {{ tabela.nome }} where 1=0");
        $bolExiste = true;
    } catch (Exception $e) {
        $bolExiste = false;
    }

    if (!$bolExiste) {
        $sql = "CREATE TABLE {{ tabela.nome }} (";
        {% for col in tabela.colunas %}
        $sql .= "{{ col.nome }} {{ col.tipo }} {% if col.chave_primaria %}PRIMARY KEY{% endif %} {% if col.obrigatorio %}NOT NULL{% else %}NULL{% endif %},";
        {% endfor %}
        $sql = rtrim($sql, ",") . ")";
        
        $objInfraBanco->executarSql($sql);
        echo "Tabela {{ tabela.nome }} criada.\n";
    }
    {% endfor %}

    echo "Script concluido com sucesso.\n";
    $objInfraBanco->fecharConexao();
} catch (Exception $e) {
    echo "ERRO: " . $e->getMessage() . "\n";
    exit(1);
}
