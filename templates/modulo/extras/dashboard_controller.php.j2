<?php
// DashboardController — {{ d.nome }}
// Gerado por SEI Module Builder (template: dashboard)

class {{ ns }}DashboardController extends InfraController {

    public function dashboard() {
        InfraHtml::exibirTemplate(
            '{{ d.slug }}/{{ d.slug }}_dashboard',
            ['arrStats' => $this->coletarEstatisticas()]
        );
    }

    private function coletarEstatisticas() {
        $stats = [];
        $objInfraBanco = BancoSEI::getInstance();
        $objInfraBanco->abrirConexao();

        {% for tabela in d.tabelas %}
        // Total — {{ tabela.nome }}
        $rowTotal = $objInfraBanco->consultarSql("SELECT COUNT(*) as total FROM {{ tabela.nome }}");
        $stats['total_{{ tabela.nome }}'] = $rowTotal[0]['total'] ?? 0;

        // Últimos 5 itens — {{ tabela.nome }}
        $stats['recent_{{ tabela.nome }}'] = $objInfraBanco->consultarSql("SELECT * FROM {{ tabela.nome }} ORDER BY 1 DESC", 5);

        {% for col in tabela.colunas %}
        {% if col.tipo == 'char(1)' and not col.chave_primaria %}
        // Distribuição por {{ col.nome }}
        $stats['dist_{{ tabela.nome }}_{{ col.nome }}'] = $objInfraBanco->consultarSql("SELECT {{ col.nome }} as label, COUNT(*) as total FROM {{ tabela.nome }} GROUP BY {{ col.nome }}");
        {% endif %}
        {% endfor %}
        {% endfor %}

        $objInfraBanco->fecharConexao();
        return $stats;
    }
}
