    </style>
    <?php
    $objPaginaSEI->fecharHead();
    $objPaginaSEI->abrirBody($strTitulo);

    // 3. Renderizar View
    ?>
    <div class="dash-container">
        
        <div class="topbar-dash">
            <div>
                <h1><i class="bi bi-speedometer2"></i> {{ d.nome }}</h1>
                <div class="subtitle">Painel de Controle e Indicadores do Módulo</div>
            </div>
            <div class="text-end text-white-50">
                <small><i class="bi bi-calendar3 me-1"></i> <?php echo date('d/m/Y H:i'); ?></small>
