        </div>

        <div class="row g-4 mb-4">
            <!-- Charts Column -->
            <div class="col-lg-8">
                <div class="row g-4">
                    {% for tabela in d.tabelas %}
                    {% for col in tabela.colunas %}
                    {% if col.tipo == 'char(1)' and not col.chave_primaria %}
                    <div class="col-md-6">
                        <div class="section-card">
                            <div class="section-title"><i class="bi bi-pie-chart-fill"></i> {{ tabela.nome | pascalcase }} por {{ col.nome | pascalcase }}</div>
