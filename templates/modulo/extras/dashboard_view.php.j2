              <div class="kpi-icon {% if loop.index is odd %}azul{% else %}verde{% endif %}">
                <i class="bi bi-database-fill"></i>
              </div>
              <div>
                <div class="kpi-valor"><?php echo number_format($arrStats['total_{{ tabela.nome }}'] ?? 0); ?></div>
