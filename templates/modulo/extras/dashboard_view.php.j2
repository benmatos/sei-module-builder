                                    <th>{{ col.nome | pascalcase }}</th>
                                    {% endfor %}
                                    <th class="text-end">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                <?php if (empty($arrStats['recent_{{ tabela.nome }}'])): ?>
                                    <tr><td colspan="3" class="text-center py-3 text-muted">Nenhum registro encontrado.</td></tr>
                                <?php else: foreach ($arrStats['recent_{{ tabela.nome }}'] as $item): ?>
                                    <tr>
                                        {% for col in tabela.colunas[:2] %}
                                        <td><?php echo $item['{{ col.nome }}']; ?></td>
                                        {% endfor %}
                                        <td class="text-end">
                                            <a href="#" class="btn btn-sm btn-outline-primary py-0"><i class="bi bi-eye"></i></a>
                                        </td>
                                    </tr>
                                <?php endfor; endif; ?>
                            </tbody>
                        </table>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <?php
    $objPaginaSEI->fecharBody();
    $objPaginaSEI->fecharHtml();

} catch (Exception $e) {
    PaginaSEI::getInstance()->processarExcecao($e);
}
