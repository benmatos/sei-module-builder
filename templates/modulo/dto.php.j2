<?php
// DTO: {{ tabela.nome }} — Gerado por SEI Module Builder

class {{ ns }}{{ tnome }}DTO extends InfraDTO {

    public function __construct() {
        parent::__construct('{{ tabela.nome }}', '{{ tabela.alias }}');
    }

    protected function inicializarPropriedades() {
        {% for col in tabela.colunas %}
        $this->adicionarPropriedade(
            InfraMapeamento::criarPropriedade('{{ col.nome | pascalcase }}', '{{ tabela.alias }}.{{ col.nome }}')
                ->definirTipo({{ col.tipo | tipo_infrabanco }})
                {% if col.chave_primaria %}->definirChavePrimaria(){% endif %}
                {% if not col.obrigatorio %}->definirOpcional(){% endif %}
        );
        {% if col.fk %}
        // FK → {{ col.fk.tabela_slug }}.{{ col.fk.coluna_pai }}
        $objFK = new InfraDTO();
        $objFK->adicionarMapeamento(
            InfraMapeamento::criarPropriedade('Str{{ col.fk.coluna_pai | pascalcase }}', '{{ col.fk.tabela_slug }}.{{ col.fk.coluna_pai }}')
        );
        {% for exibir in col.fk.colunas_exibir %}
        $objFK->adicionarMapeamento(
            InfraMapeamento::criarPropriedade('Str{{ exibir | pascalcase }}', '{{ col.fk.tabela_slug }}.{{ exibir }}')
        );
        {% endfor %}
        $this->adicionarPropriedade(
            InfraMapeamento::criarPropriedadeObjeto('Obj{{ col.fk.tabela_slug | pascalcase }}', $objFK)
                ->definirOpcional()
        );
        {% endif %}
        {% endfor %}
    }
}
