<?php
// DTO: {{ tabela.nome }} — Gerado por SEI Module Builder

class {{ ns }}{{ tnome }}DTO extends InfraDTO {

    public function getStrNomeTabela() {
        return '{{ tabela.nome }}';
    }

    public function montar() {
        {% for col in tabela.colunas %}
        {% set prefix = 'InfraDTO::$PREFIXO_STR' %}
        {% if col.tipo == 'int' or col.tipo == 'bigint' %}{% set prefix = 'InfraDTO::$PREFIXO_NUM' %}
        {% elif col.tipo == 'decimal(15,2)' %}{% set prefix = 'InfraDTO::$PREFIXO_NUM' %}
        {% elif col.tipo == 'date' %}{% set prefix = 'InfraDTO::$PREFIXO_DTA' %}
        {% elif col.tipo == 'datetime' %}{% set prefix = 'InfraDTO::$PREFIXO_DTH' %}
        {% endif %}
        $this->adicionarAtributoTabela({{ prefix }}, '{{ col.nome | pascalcase }}', '{{ col.nome }}');
        {% endfor %}

        {% set pk_col = (tabela.colunas | selectattr("chave_primaria") | first) or tabela.colunas[0] %}
        $this->configurarPK('{{ pk_col.nome | pascalcase }}', InfraDTO::$TIPO_PK_NATIVA);
    }
}
